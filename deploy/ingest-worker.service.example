# Template only. Not installed or enabled by this project.
# Replace user, installation path, data_root and writable-directory permissions first.
[Unit]
Description=Automatic ROS bag cleaning and multimodal LeRobot ingestion
After=local-fs.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/convert-data-job-worker
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/convert-data-job-worker/.venv/bin/python -m convest.ingest.cli run --config /opt/convert-data-job-worker/configs/ingest.server.yaml
Restart=on-failure
RestartSec=30
KillMode=mixed
TimeoutStopSec=900
UMask=0022

[Install]
WantedBy=multi-user.target
